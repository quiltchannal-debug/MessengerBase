[Unit]
Description=OrangeM messenger server (C++)
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=orangem
Group=orangem
WorkingDirectory=/opt/orangem
EnvironmentFile=/opt/orangem/orangem.env
ExecStart=/opt/orangem/server/orangem --data /opt/orangem/data --web /opt/orangem/web
Restart=always
RestartSec=2
StandardOutput=append:/var/log/orangem.log
StandardError=append:/var/log/orangem.log

# sandboxing (kept mild because we need the data dir writable)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/orangem/data

[Install]
WantedBy=multi-user.target
