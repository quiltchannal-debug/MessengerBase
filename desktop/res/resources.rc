#include <windows.h>

#define IDI_APPICON 101
#define IDR_LOGO    102

IDI_APPICON ICON "app.ico"
IDR_LOGO     RCDATA "logo.jpg"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName",      "OrangeM"
      VALUE "FileDescription",  "OrangeM — messenger (Windows client)"
      VALUE "FileVersion",      "1.0.0.0"
      VALUE "InternalName",     "orangem"
      VALUE "LegalCopyright",   "OrangeM"
      VALUE "OriginalFilename", "orangem.exe"
      VALUE "ProductName",      "OrangeM"
      VALUE "ProductVersion",   "1.0.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
